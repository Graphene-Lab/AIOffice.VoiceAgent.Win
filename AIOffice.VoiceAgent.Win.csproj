<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Configurations>Debug;Release;Test</Configurations>
    <Description>Voice agent executable (Windows only). WinRT offline speech recognition + KokoroSharp neural TTS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared Kokoro TTS (assets + logic) lives in the cross-platform AIOffice.VoiceAgent:
         the model (kokoro.onnx) is downloaded at build time by that project and deployed at the
         app base dir, and the voices ship with KokoroSharp 0.8.4. This agent only keeps the
         Windows-specific recognition (WinRT) and the SAPI fallback synthesizer. -->
    <ProjectReference Include="..\AIOffice.VoiceAgent\AIOffice.VoiceAgent.csproj" />
    <PackageReference Include="KokoroSharp" Version="0.8.4" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
